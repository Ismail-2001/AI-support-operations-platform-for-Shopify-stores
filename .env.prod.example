# ──────────────────────────────────────────────────────────────
# PRODUCTION ENVIRONMENT
# ──────────────────────────────────────────────────────────────
# This file is for production deployment reference only.
# NEVER commit actual production values to git.
# Use your deployment platform's secret management instead.

# ── Tenant ──────────────────────────────────────────────────
TENANT_NAME=your-production-tenant

# ── LLM ─────────────────────────────────────────────────────
GROQ_API_KEY=your-production-groq-key
GROQ_MODEL=llama-3.3-70b-versatile
# ANTHROPIC_API_KEY=your-fallback-key  # Optional: for fallback
# FALLBACK_MODEL=claude-haiku-4-5-20251001

# ── Shopify ─────────────────────────────────────────────────
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_your-production-token

# ── Gorgias ─────────────────────────────────────────────────
GORGIAS_DOMAIN=your-store
GORGIAS_EMAIL=support@yourstore.com
GORGIAS_API_KEY=your-production-gorgias-key
GORGIAS_WEBHOOK_SECRET=generate-a-random-string

# ── Automation policy ───────────────────────────────────────
# Start with false, enable after reviewing drafts for 1-2 weeks
AUTO_SEND_ENABLED=false
AUTO_SEND_MIN_CONFIDENCE=0.90
AUTO_SEND_BLOCKED_CATEGORIES=refund,complaint,legal,other

# ── Storage ─────────────────────────────────────────────────
# NOTE: SQLite on Render free tier is EPHEMERAL (wiped every deploy).
# Paying clients: Render Starter ($7/mo) + attached disk, then set
#   DB_PATH=/var/data/cs_agent.db
# Long-term: PostgreSQL (not yet implemented — see DEPLOYMENT_CHECKLIST.md
# → "Production Storage"). Verify with GET /health -> checks.storage.
DB_PATH=cs_agent.db
ENV=production

# ── API Security ────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your-production-api-key
REQUIRE_API_KEY=true
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
RATE_LIMIT_PER_MINUTE=60
REFUND_RATE_LIMIT_PER_MINUTE=10
RESEND_RATE_LIMIT_PER_MINUTE=10
INBOUND_WEBHOOK_SECRET=your-production-webhook-secret

# ── Cost governance ─────────────────────────────────────────
DAILY_COST_CAP_USD=5.0
