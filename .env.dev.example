# ──────────────────────────────────────────────────────────────
# DEVELOPMENT ENVIRONMENT
# ──────────────────────────────────────────────────────────────
# This file is for local development only.
# Copy this to .env and fill in your values.

# ── Tenant ──────────────────────────────────────────────────
TENANT_NAME=dev-store

# ── LLM ─────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# ── Shopify (optional for dev) ──────────────────────────────
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ACCESS_TOKEN=

# ── Gorgias (optional for dev) ──────────────────────────────
GORGIAS_DOMAIN=
GORGIAS_EMAIL=
GORGIAS_API_KEY=
GORGIAS_WEBHOOK_SECRET=

# ── Automation policy ───────────────────────────────────────
AUTO_SEND_ENABLED=false
AUTO_SEND_MIN_CONFIDENCE=0.85
AUTO_SEND_BLOCKED_CATEGORIES=refund,complaint,legal,other

# ── Storage ─────────────────────────────────────────────────
DB_PATH=cs_agent_dev.db
ENV=development

# ── API Security ────────────────────────────────────────────
API_KEY=dev-api-key-change-me
REQUIRE_API_KEY=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
REFUND_RATE_LIMIT_PER_MINUTE=30
RESEND_RATE_LIMIT_PER_MINUTE=30
INBOUND_WEBHOOK_SECRET=dev-webhook-secret-change-me

# ── Cost governance ─────────────────────────────────────────
DAILY_COST_CAP_USD=10.0
