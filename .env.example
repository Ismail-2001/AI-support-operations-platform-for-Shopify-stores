# --- Tenant (required — one deployed instance per client) ---
# This is a deployment label, NOT a row-level filter. Every instance serves exactly
# one client. If you're deploying a second client, deploy a separate instance with
# its own .env and database.
TENANT_NAME=your-client-name

# --- LLM (required — pick ONE primary provider) ---
# Provider priority: OPENROUTER_API_KEY > GROQ_API_KEY > GOOGLE_API_KEY
# Only the highest-priority one needs to be set. Set ANTHROPIC_API_KEY for fallback.
# WARNING: GOOGLE_API_KEY is required for Knowledge Base / RAG search, separate from chat.
# See the GOOGLE_API_KEY section below — it must be set even if you use Groq or OpenRouter
# for classification/response drafting.

# Option B: Groq (fast, cheap, open-source — NOT eval-validated, use as alternative).
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Option A: OpenRouter (gpt-4o-mini — eval-validated, recommended primary).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Google API Key (REQUIRED for Knowledge Base / RAG search) ---
# This is SEPARATE from your chat provider. Even if you use Groq or OpenRouter for
# classification/response drafting, you MUST set this for the knowledge base to work.
# Embeddings use Google's text-embedding-004 regardless of your chat provider.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-2.0-flash

# Fallback: Claude Haiku. Add an Anthropic key and it's used automatically when
# the primary provider has an outage.
ANTHROPIC_API_KEY=your-anthropic-api-key
FALLBACK_MODEL=claude-haiku-4-5-20251001

# --- Shopify (required for order lookups) ---
# Create a custom app: Shopify Admin > Settings > Apps and sales channels > Develop apps
# Scopes needed: read_orders
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxx

# --- Gorgias (required for ticket sync) ---
# API key: Gorgias > Settings > REST API
GORGIAS_DOMAIN=your-store
GORGIAS_EMAIL=you@yourstore.com
GORGIAS_API_KEY=your-gorgias-api-key
# Set this to any random string, and put the SAME value as a custom header
# named "x-webhook-secret" on the Gorgias webhook you configure.
GORGIAS_WEBHOOK_SECRET=change-me-to-a-random-string

# --- Automation policy ---
# Start with AUTO_SEND_ENABLED=false. Every reply becomes a draft/internal note in Gorgias
# for a human to approve. Once you trust the agent's judgment on a given client (usually after
# a week or two of reviewing drafts), flip this to true.
AUTO_SEND_ENABLED=false
AUTO_SEND_MIN_CONFIDENCE=0.85
AUTO_SEND_BLOCKED_CATEGORIES=refund,complaint,legal,other,subscription

# Path to the SQLite DB. The default gets auto-prefixed with TENANT_NAME
# (cs_agent_<tenant>.db). On Render free plan the file is EPHEMERAL — wiped on
# every deploy. Fine for demos. Paying clients: attach a disk and use an
# absolute path, e.g. DB_PATH=/var/data/cs_agent.db — see
# DEPLOYMENT_CHECKLIST.md → "Production Storage". Parent dirs are auto-created.
DB_PATH=cs_agent.db
# How many of the most recent messages load into the LLM prompt per graph run.
# Keeps token cost flat on long tickets (0 = full history, unbounded).
MAX_HISTORY_MESSAGES=40
ENV=development

# --- API Security ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me-generate-a-real-random-key
REQUIRE_API_KEY=true
# Comma-separated. Your dashboard's domain(s) only. Leave empty to block ALL browser calls.
ALLOWED_ORIGINS=
RATE_LIMIT_PER_MINUTE=60
REFUND_RATE_LIMIT_PER_MINUTE=10
RESEND_RATE_LIMIT_PER_MINUTE=10

# Cost governance
DAILY_COST_CAP_USD=5.0

# Secret for the generic /webhooks/inbound endpoint (WhatsApp/chat-widget/etc).
# Generate the same way as API_KEY above.
INBOUND_WEBHOOK_SECRET=change-me-generate-a-real-random-key

# Optional: Slack-compatible webhook URL for operational alerts (circuit opened,
# dead letter recorded, daily cost cap exceeded). Empty = alerts stay in logs only.
ALERT_WEBHOOK_URL=
# --- Subscriptions (Recharge / Skio) ---
# Recharge admin API token: Recharge merchant portal > Apps > API tokens
# (https://developer.rechargepayments.com). Enables pause/skip/cancel/address/frequency.
RECHARGE_API_TOKEN=
# Skio API token: Skio dashboard > API & Integrations > API (https://code.skio.com).
# Sent as: authorization: API <token>
SKIO_API_TOKEN=
# Which provider manages this store's subscriptions: auto | recharge | skio
SUBSCRIPTION_PROVIDER=auto
# Recharge has no pause endpoint - pause pushes the next charge out by this many days.
SUBSCRIPTION_PAUSE_DAYS=30

# --- Return labels (ShipEngine) ---
# https://docs.shipstation.com/apis/shipengine - header API-Key.
SHIPENGINE_API_KEY=
# Days after order creation during which a return label may be issued.
RETURN_WINDOW_DAYS=30
# Store return address - where prepaid return labels ship TO. Required for rates.
RETURN_ADDRESS_NAME=
RETURN_ADDRESS1=
RETURN_ADDRESS2=
RETURN_CITY=
RETURN_STATE=
RETURN_ZIP=
RETURN_COUNTRY=US
RETURN_PHONE=
# Fallback package size for rate estimates (oz / inches).
RETURN_PACKAGE_WEIGHT_OZ=16
RETURN_PACKAGE_LENGTH_IN=10
RETURN_PACKAGE_WIDTH_IN=8
RETURN_PACKAGE_HEIGHT_IN=4